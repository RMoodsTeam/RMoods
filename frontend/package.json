{
  "name": "frontend",
  "private": true,
  "homepage": "https://rmoods.online",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cypress:open": "cypress open",
    "build-docs": "typedoc --plugin typedoc-plugin-rename-defaults --entryPointStrategy expand src/",
    "e2e": "start-server-and-test dev http://localhost:8000 \"cypress open --e2e\"",
    "e2e:headless": "start-server-and-test dev http://localhost:8000 \"cypress run --e2e\"",
    "component": "cypress open --component",
    "component:headless": "cypress run --component",
    "percy:run": "start-server-and-test dev http://localhost:8000 \"npx percy exec -- npx cypress run --headless --spec \"cypress/e2e/VisualRegression.cy.ts\"\""
  },
  "dependencies": {
    "@mantine/charts": "^7.13.4",
    "@mantine/core": "^7.13.4",
    "@mantine/dates": "^7.13.4",
    "@mantine/form": "^7.13.4",
    "@mantine/hooks": "^7.13.4",
    "@mantine/modals": "^7.13.4",
    "@mantine/notifications": "^7.13.4",
    "@mantine/spotlight": "^7.13.4",
    "@react-oauth/google": "^0.12.1",
    "@tabler/icons-react": "^3.17.0",
    "@tanstack/react-query": "^5.61.5",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "framer-motion": "^11.9.0",
    "jotai": "^2.10.0",
    "js-cookie": "^3.0.5",
    "jwt-decode": "^4.0.0",
    "mantine-form-zod-resolver": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^4.1.2",
    "react-icons": "^5.3.0",
    "react-router-dom": "^6.26.2",
    "react-use-websocket": "^4.11.1",
    "recharts": "^2.13.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@percy/cli": "^1.30.5",
    "@percy/cypress": "^3.1.3",
    "@tanstack/eslint-plugin-query": "^5.61.4",
    "@types/cypress": "^1.1.3",
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cypress": "^13.15.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "postcss": "^8.4.48",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.4.2",
    "sass-embedded": "^1.83.0",
    "start-server-and-test": "^2.0.8",
    "typedoc": "^0.26.8",
    "typedoc-plugin-rename-defaults": "^0.7.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1"
  }
